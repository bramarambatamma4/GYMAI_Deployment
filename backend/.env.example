# Gemini AI workout planning (optional; local planner is used when omitted)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Location alerts: key required to POST /api/notifications/events (use a long random value)
ADMIN_API_KEY=
# Nightly incomplete-workout reminder
FRONTEND_URL=http://localhost:5173
SCHEDULER_TIMEZONE=Asia/Kolkata
REMINDER_HOUR=21
REMINDER_MINUTE=0
REMINDER_ENABLED=true

# Google sign-in (same client id as VITE_GOOGLE_CLIENT_ID in frontend/.env)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
REGISTRATION_CODE_EXPIRE_MINUTES=10
REGISTRATION_RESEND_SECONDS=60
